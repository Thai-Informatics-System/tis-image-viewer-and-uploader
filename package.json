{
  "name": "tis-ng-image-and-file-upload-and-view",
  "version": "2.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve  --port 4201",
    "build": "ng build",
    "build-library": "ng build tis-image-and-file-upload-and-view --configuration=production",
    "build-library-watch": "ng build tis-image-and-file-upload-and-view --configuration=production --watch",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:mobile": "ng build tis-mobile-upload",
    "build:mobile:stage": "ng build tis-mobile-upload --configuration=stage",
    "build:mobile:prod": "ng build tis-mobile-upload --configuration=production",
    "serve:mobile": "ng serve tis-mobile-upload --configuration=development --port 4202 --host 0.0.0.0 --disable-host-check"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.3",
