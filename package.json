    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.5",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "angularx-qrcode": "^22.0.1",
    "browser-image-compression": "^2.0.2",
    "ngx-extended-pdf-viewer": "^31.0.1",
    "ngx-scanner-qrcode": "^1.8.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
